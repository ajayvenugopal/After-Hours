# Public sample mode makes no provider calls.
GP_NOTES_LIVE_ENABLED=false
OPENAI_API_KEY=
# Generate a workspace token: openssl rand -hex 32
# This is distinct from the provider key. Never use NEXT_PUBLIC_ for credentials.
GP_NOTES_ACCESS_TOKEN=
OPENAI_NOTE_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Optional behind a reverse proxy: exact browser origin, no trailing slash.
# GP_NOTES_ORIGIN=https://notes.example.com
