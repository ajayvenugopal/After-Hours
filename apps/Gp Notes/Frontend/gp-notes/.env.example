# Default: public fixture demo, no provider calls.
GP_NOTES_LIVE_ENABLED=false
# To enable live input, set true above and supply BOTH credentials below.
OPENAI_API_KEY=
# Generate your own value: openssl rand -hex 32 (at least 32 characters).
# Workspace access token is distinct from your OpenAI key. Never use NEXT_PUBLIC_.
GP_NOTES_ACCESS_TOKEN=
OPENAI_NOTE_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Optional behind a reverse proxy: exact browser origin, no trailing slash.
# GP_NOTES_ORIGIN=https://notes.example.com
